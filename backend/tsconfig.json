{
  "compilerOptions": {
    // Environment Settings
    "module": "commonjs",
    "target": "es2022",
    
    // Uncommenting this allows Node types to load
    // "types": ["node"], 

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    
    // Set to false or remove unless you are strictly doing isolated type imports
    "verbatimModuleSyntax": false, 
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}